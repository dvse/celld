{
  "name": "loader-props-acceptance",
  "main": "index.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "worker_loaders": [{"binding": "LOADER"}],
  "vars": {"AMBIENT_TEST": "parent-only-fixture"},
  "durable_objects": {"bindings": [{"name": "ROOT", "class_name": "Root"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Root"]}]
}
